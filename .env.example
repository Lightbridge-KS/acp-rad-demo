# Copy to `.env` (gitignored) and fill in what you use. The rad-agent reads it at start
# (python-dotenv, searched upward from agents/rad-agent/), so `just dev` and `just smoke`
# pick it up with no shell setup. Docker Compose also reads this file and passes only the
# variables declared in compose.yaml. See docs/dev/running.md §Model / provider.

# --- Provider keys (only the ones your models need) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Dedicated Vercel AI Gateway key; preferred over OPENAI_API_KEY when a base URL is set.
AI_GATEWAY_API_KEY=

# --- Model selection ---
# One model:
#RAD_MODEL=openai:gpt-5.6-terra
# Several, switchable from the sidebar header (first = default):
#RAD_MODELS=openai:gpt-5.6-terra,anthropic:claude-sonnet-5
# Offline through any OpenAI-compatible endpoint (Ollama shown); applies to every model above:
#RAD_MODEL=openai:gpt-oss:20b
# Native run (`just dev`):
#RAD_MODEL_BASE_URL=http://localhost:11434/v1
# Container run (`just up`):
#RAD_MODEL_BASE_URL=http://host.docker.internal:11434/v1

# Vercel Production uses these exact model settings (configure in Vercel, not `.env`):
#RAD_MODEL=openai/gpt-5.6-terra
#RAD_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1

# --- Public-demo safeguards (Vercel environment variables) ---
#DEMO_LLM_ENABLED=true                   # Production only; false in Preview
#VERCEL_SUPPORT_MAX_CONCURRENCY=1        # Vercel beta opt-in for maxConcurrency
#ACTIVE_SESSION_LIMIT=10
#SESSION_LEASE_TTL_SECONDS=90
#SESSION_LEASE_HEARTBEAT_SECONDS=30
#AUDIT_RETENTION_SECONDS=604800          # 7 days
# Upstash Marketplace injects UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.

# --- Container listener (safe default: this Mac only) ---
#APP_HOST=127.0.0.1
#APP_PORT=8080
#BRIDGE_HOST_PORT=8787  # loopback-only smoke-test port

# --- Diagnostics ---
#RAD_LOG_LEVEL=INFO      # agent logging level (stderr)
#BRIDGE_TRACE=1          # bridge logs every JSON-RPC frame's method/id (never params)
#AUDIT_DIR=./audit       # native run only; Compose uses its persistent audit-data volume
